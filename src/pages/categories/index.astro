---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { groupBy } from '../../utils/taxonomy';

const cats = [...(await groupBy('categories'))].sort((a, b) => b[1].posts.length - a[1].posts.length);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`分类 | ${SITE_TITLE}`} description={`共 ${cats.length} 个分类`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>分类</h1>
			<ul class="taxonomy-list">
				{
					cats.map(([slug, { name, posts }]) => (
						<li>
							<a href={`/categories/${slug}/`}>
								{name} <span class="count">{posts.length}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
