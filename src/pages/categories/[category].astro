---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { groupBy, type Post } from '../../utils/taxonomy';

export async function getStaticPaths() {
	const cats = await groupBy('categories');
	return [...cats].map(([slug, { name, posts }]) => ({
		params: { category: slug },
		props: { name, posts },
	}));
}

const { name, posts } = Astro.props as { name: string; posts: Post[] };
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${name} | ${SITE_TITLE}`} description={`分类「${name}」下的 ${posts.length} 篇文章`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{name}</h1>
			<p class="count">{posts.length} 篇文章</p>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/posts/${post.id}/`}>{post.data.title}</a>
							<FormattedDate date={post.data.pubDate} />
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
