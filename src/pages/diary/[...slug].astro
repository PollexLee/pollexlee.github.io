---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import DiaryGate from "@/components/DiaryGate.astro";
import type { EncryptedPayload } from "@/components/DiaryGate.astro";
import config from "@/config";

export async function getStaticPaths() {
  // 密文由 scripts/encrypt-diary.mjs 在本地生成后提交；
  // 明文不在仓库里，构建过程也不需要知道答案。
  const files = import.meta.glob<EncryptedPayload>("@/data/diary/*.json", {
    import: "default",
    eager: true,
  });

  return Object.entries(files)
    .filter(([file]) => !file.endsWith("_index.json"))
    .map(([file, payload]) => ({
      params: { slug: file.split("/").pop()!.replace(/\.json$/, "") },
      props: { payload },
    }));
}

type Props = { payload: EncryptedPayload };

const { payload } = Astro.props;
---

<Layout title={`日记 | ${config.site.title}`} description="私人记录，需要验证。">
  <Header />

  <Breadcrumb />

  {/* 标题一律显示为「日记」，页面上不出现任何正文信息 */}
  <Main pageTitle="日记" class="app-prose">
    <DiaryGate {payload} />
    <p class="mt-8 text-sm">
      <a
        href="/diary/"
        class="text-accent underline decoration-dashed underline-offset-4"
        >← 返回日记列表</a
      >
    </p>
  </Main>

  <Footer />
</Layout>
