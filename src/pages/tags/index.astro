---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { groupBy } from '../../utils/taxonomy';

const tags = [...(await groupBy('tags'))].sort((a, b) => b[1].posts.length - a[1].posts.length);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签 | ${SITE_TITLE}`} description={`共 ${tags.length} 个标签`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>标签</h1>
			<ul class="taxonomy-list">
				{
					tags.map(([slug, { name, posts }]) => (
						<li>
							<a href={`/tags/${slug}/`}>
								#{name} <span class="count">{posts.length}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
