---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { publicPosts } from '../../utils/taxonomy';

const posts = await publicPosts();

// 按年份分组归档，与旧站的归档页结构保持一致
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const y = post.data.pubDate.getFullYear();
	if (!years.has(y)) years.set(y, []);
	years.get(y)!.push(post);
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 | ${SITE_TITLE}`} description={`全部 ${posts.length} 篇文章`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>文章</h1>
			<p class="count">共 {posts.length} 篇</p>
			{
				[...years].map(([year, list]) => (
					<section>
						<h2>{year}</h2>
						<ul class="archive">
							{list.map((post) => (
								<li>
									<a href={`/posts/${post.id}/`}>{post.data.title}</a>
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.getMonth() + 1} 月 {post.data.pubDate.getDate()} 日
									</time>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.count {
		color: rgb(var(--gray));
	}
	section h2 {
		margin: 1.5em 0 0.5em;
		padding-bottom: 0.2em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.archive {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.archive li {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		padding: 0.35em 0;
	}
	.archive time {
		flex-shrink: 0;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
</style>
